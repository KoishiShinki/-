# Docker Compose reads this file after you copy it to .env.
# Generate unique local passwords. Never commit the populated .env.
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
ADMIN_USERNAME=
ADMIN_PASSWORD=
APP_PORT=8088
APP_ORIGIN=http://localhost:8088
SECURE_COOKIE=false

# AI is opt-in. Keys are used by the backend only.
AI_ENABLED=false
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
TEXT_MODEL=deepseek-ai/DeepSeek-V3.2
VISION_MODEL=Qwen/Qwen3-VL-32B-Thinking
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1
